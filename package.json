{
	"name": "joelparkerhenderson.github.io",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "pagefind --site build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
